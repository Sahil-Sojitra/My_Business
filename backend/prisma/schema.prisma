// Prisma schema file for My_Business backend
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum BillStatus {
  PENDING
  OVERDUE
  PARTIAL
  PAID
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

/// Authenticated broker account holder
model User {
  id              String      @id @default(uuid())
  name            String
  mobileNumber    String      @unique // Primary unique login identifier
  email           String?     // Profile and notification email
  passwordHash    String
  businessName    String?     @default("My Business")
  isEmailVerified Boolean     @default(false)
  tokenVersion    Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Multi-tenant relations: each broker owns their companies and bills
  companies       Company[]
  bills           Bill[]
  emailOtps       EmailOtp[]

  @@index([mobileNumber])
  @@index([email])
  @@map("users")
}

/// Cryptographic one-time password records for email verification and password reset
model EmailOtp {
  id                String      @id @default(uuid())
  userId            String?
  email             String
  otpHash           String
  purpose           OtpPurpose
  expiresAt         DateTime
  attempts          Int         @default(0)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@index([expiresAt])
  @@map("email_otps")
}

/// Registered buyer company / client firm
model Company {
  id            String    @id @default(uuid())
  userId        String
  name          String
  ownerName     String?
  contactNumber String
  gstin         String?
  address       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills         Bill[]

  @@index([userId])
  @@index([name])
  @@map("companies")
}

/// Consignment sales bill / invoice
model Bill {
  id                  String       @id @default(uuid())
  userId              String
  companyId           String
  companyName         String       // Cached for fast list queries
  billNumber          String?
  amount              Decimal      @db.Decimal(12, 2)
  dalaliRate          Decimal      @default(1.50) @db.Decimal(5, 2) // Commission percentage (e.g. 1.50%)
  dalaliAmount        Decimal      @db.Decimal(12, 2)               // Static: (amount * dalaliRate) / 100
  date                String                                        // Invoice date (YYYY-MM-DD)
  dueDate             String?                                       // Credit deadline (YYYY-MM-DD)
  status              BillStatus   @default(PENDING)
  description         String?

  // File Attachments metadata (stored as JSON)
  billPdf             Json?
  chitthi             Json?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@map("bills")
}

/// Durable background cleanup task for orphaned Backblaze B2 files
model StorageCleanupTask {
  id        String   @id @default(uuid())
  userId    String
  fileKey   String
  attempts  Int      @default(0)
  lastError String?
  status    String   @default("PENDING") // PENDING, PROCESSING, FAILED, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("storage_cleanup_tasks")
}

