# ==============================================================================
# Environment Configuration Template for My_Business Backend (Stage 1)
# Copy this file to .env and configure your Prisma Postgres cloud credentials:
#   copy .env.example .env
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Prisma Postgres Cloud Connection Strings:
# 1. Pooled TCP connection string for application runtime queries (via PgBouncer):
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# 2. Direct TCP connection string for Prisma CLI operations and database migrations:
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

